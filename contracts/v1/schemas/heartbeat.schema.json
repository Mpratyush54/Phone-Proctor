{
  "$id": "https://phone-proctor.local/contracts/v1/heartbeat.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heartbeat",
  "type": "object",
  "additionalProperties": true,
  "required": ["v", "type", "msg_id", "ts", "payload"],
  "properties": {
    "v": { "const": 1 },
    "type": { "const": "heartbeat" },
    "msg_id": { "type": "string" },
    "session_id": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rtt_ms": { "type": "number" },
        "cpu": { "type": "number" },
        "connectivity": { "type": "string" }
      }
    }
  }
}
