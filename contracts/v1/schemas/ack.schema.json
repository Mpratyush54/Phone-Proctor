{
  "$id": "https://phone-proctor.local/contracts/v1/ack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ack",
  "type": "object",
  "additionalProperties": true,
  "required": ["v", "type", "payload"],
  "properties": {
    "v": { "const": 1 },
    "type": { "const": "ack" },
    "msg_id": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["acked_through"],
      "additionalProperties": true,
      "properties": {
        "acked_through": { "type": "integer", "minimum": 0 },
        "session_id": { "type": "string" }
      }
    }
  }
}
