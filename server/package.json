{
  "name": "@phone-proctor/server",
  "private": true,
  "version": "0.1.0",
  "description": "Central control plane for Phone-Proctor (agent + examiner relay)",
  "type": "module",
  "main": "src/index.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api": "tsx --env-file=.env src/api.ts",
    "gateway": "tsx --env-file=.env src/gateway.ts",
    "worker": "tsx --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "validate:contracts": "tsx --env-file=.env src/validate-contracts.ts",
    "start": "node --env-file=.env src/index.cjs",
    "dev": "node --env-file=.env --watch src/index.cjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "oidc-provider": "^9.12.2",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "mongodb": "^6.12.0",
    "redis": "^4.7.0"
  }
}
